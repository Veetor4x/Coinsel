# Coinsel — variable NAMES only. Real values go in your cloud/Vercel environment settings. NEVER commit secrets.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
DAO_ACCOUNT_ID=
AGENT_ACCOUNT_ID=
AGENT_FUNCTION_CALL_PRIVATE_KEY=   # testnet, add_proposal-only key
COUNCIL_1_ACCOUNT_ID=
COUNCIL_1_PRIVATE_KEY=             # testnet, DEMO_MODE only
COUNCIL_2_ACCOUNT_ID=
COUNCIL_2_PRIVATE_KEY=
COUNCIL_3_ACCOUNT_ID=
COUNCIL_3_PRIVATE_KEY=
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=                      # optional; without it a 0.2% fee applies to quotes
DEMO_MODE=true
# --- Step 2: REAL testnet swap through Tidepool (community NEAR Intents sandbox). All optional; OFF unless the first is "true". ---
TIDEPOOL_SWAP_ENABLED=false        # set to true to turn the real test swap on (otherwise Step 2 stays "quote only")
TIDEPOOL_API_URL=https://www.usetidepool.tech
TIDEPOOL_API_KEY=                  # optional; Tidepool accepts any value and only uses it to pick the lower fee tier. Server-side only
PAYROLL_PRIVATE_KEY=               # testnet, DEMO_MODE only: key of the payroll account (used only by "Reset demo" to send money back to the DAO)
# Setup scripts only (never needed on Vercel): FUNDER_ACCOUNT_ID, FUNDER_PRIVATE_KEY
